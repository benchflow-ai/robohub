# Agent-skills task genesis-rigid-snapshot-cleanup, variant with-skill. Generated by datasets/agent-skills/tools/build.py from src/genesis-rigid-snapshot-cleanup/; edit the source, not this file.
# Genesis at commit 1a6d3c40b566038f846d75335ca4c07e74b88fc0 (Apache-2.0, https://github.com/Genesis-Embodied-AI/genesis-world), fetched at build time without its git history.
FROM python:3.12-slim-bookworm
# curl, xz-utils and ca-certificates let BenchFlow install the agent harnesses (Claude Code, Codex) at run time.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates xz-utils ripgrep build-essential libgl1 libegl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /opt/skills-study/requirements.txt
# requirements.txt pins every package, torch as its CPU-only build (+cpu) from the PyTorch index.
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r /opt/skills-study/requirements.txt
RUN git init -q /workspace/genesis-world && cd /workspace/genesis-world \
 && git fetch -q --depth 1 https://github.com/Genesis-Embodied-AI/genesis-world.git 1a6d3c40b566038f846d75335ca4c07e74b88fc0 && git checkout -q FETCH_HEAD && rm -rf .git
RUN cd /workspace/genesis-world && pip install --no-cache-dir --no-deps --no-build-isolation -e .
COPY setup/ /opt/skills-study/setup/
COPY variant.sh integrity.py /opt/skills-study/
# Starting state, then the variant step (no-skill deletes the guide files; with-skill changes nothing), then the
# integrity manifest of the protected upstream files (root-only, read by the verifier) and a fresh one-commit git repository.
RUN cd /workspace/genesis-world && sh /opt/skills-study/setup/apply.sh && rm -rf /opt/skills-study/setup \
 && sh /opt/skills-study/variant.sh \
 && python3 /opt/skills-study/integrity.py write tests genesis/engine genesis/utils/misc.py > /opt/skills-study/protected.sha256 \
 && chmod -R go-rwx /opt/skills-study \
 && git init -q && git add -A \
 && git -c user.name=workspace -c user.email=workspace@localhost commit -qm "Workspace" \
 && mkdir -p /logs/verifier /logs/agent /logs/artifacts
ENV PYTHONUNBUFFERED=1
WORKDIR /workspace/genesis-world
