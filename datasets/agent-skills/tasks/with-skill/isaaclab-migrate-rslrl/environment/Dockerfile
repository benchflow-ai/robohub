# Agent-skills task isaaclab-migrate-rslrl, variant with-skill. Generated by datasets/agent-skills/tools/build.py from src/isaaclab-migrate-rslrl/; edit the source, not this file.
# Isaac Lab at commit f87ae20f93cd68ce1c477b73b8b09bac7df01ff9 (BSD-3-Clause, https://github.com/isaac-sim/IsaacLab), fetched at build time without its git history.
FROM python:3.12-slim-bookworm
# curl, xz-utils and ca-certificates let BenchFlow install the agent harnesses (Claude Code, Codex) at run time.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates xz-utils ripgrep build-essential \
 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /opt/skills-study/requirements.txt
# requirements.txt pins every package, torch as its CPU-only build (+cpu) from the PyTorch index.
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r /opt/skills-study/requirements.txt
RUN git init -q /workspace/IsaacLab && cd /workspace/IsaacLab \
 && git fetch -q --depth 1 https://github.com/isaac-sim/IsaacLab.git f87ae20f93cd68ce1c477b73b8b09bac7df01ff9 && git checkout -q FETCH_HEAD && rm -rf .git
RUN cd /workspace/IsaacLab && for p in isaaclab isaaclab_assets isaaclab_contrib isaaclab_experimental isaaclab_newton isaaclab_ov isaaclab_physx isaaclab_rl isaaclab_tasks isaaclab_tasks_experimental isaaclab_visualizers; do pip install --no-cache-dir --no-deps --no-build-isolation -e source/$p || exit 1; done
COPY setup/ /opt/skills-study/setup/
COPY variant.sh integrity.py /opt/skills-study/
# Starting state, then the variant step (no-skill deletes the guide files; with-skill changes nothing), then the
# integrity manifest of the protected upstream files and a fresh one-commit git repository, whose commit id is kept for the verifier (both root-only).
RUN cd /workspace/IsaacLab && sh /opt/skills-study/setup/apply.sh && rm -rf /opt/skills-study/setup \
 && sh /opt/skills-study/variant.sh \
 && python3 /opt/skills-study/integrity.py write source/isaaclab/isaaclab source/isaaclab_physx/isaaclab_physx source/isaaclab_newton/isaaclab_newton source/isaaclab_rl/isaaclab_rl source/isaaclab_tasks/isaaclab_tasks/utils source/isaaclab_tasks/isaaclab_tasks/core > /opt/skills-study/protected.sha256 \
 && chmod -R go-rwx /opt/skills-study \
 && git init -q && git add -A \
 && git -c user.name=workspace -c user.email=workspace@localhost commit -qm "Workspace" \
 && git rev-parse HEAD > /opt/skills-study/base_commit \
 && mkdir -p /logs/verifier /logs/agent /logs/artifacts
ENV PYTHONUNBUFFERED=1
WORKDIR /workspace/IsaacLab
