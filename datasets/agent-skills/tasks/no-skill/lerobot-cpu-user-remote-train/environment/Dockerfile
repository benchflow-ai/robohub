# Agent-skills task lerobot-cpu-user-remote-train, variant no-skill. Generated by datasets/agent-skills/tools/build.py from src/lerobot-cpu-user-remote-train/; edit the source, not this file.
# LeRobot at commit 297774fca4e3ad0aa34e7425fbf937111637e77b (Apache-2.0, https://github.com/huggingface/lerobot), fetched at build time without its git history.
FROM python:3.12-slim-bookworm
# curl, xz-utils and ca-certificates let BenchFlow install the agent harnesses (Claude Code, Codex) at run time.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates xz-utils ripgrep build-essential ffmpeg \
 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /opt/skills-study/requirements.txt
# requirements.txt pins every package, torch as its CPU-only build (+cpu) from the PyTorch index.
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r /opt/skills-study/requirements.txt
RUN git init -q /workspace/lerobot && cd /workspace/lerobot \
 && git fetch -q --depth 1 https://github.com/huggingface/lerobot.git 297774fca4e3ad0aa34e7425fbf937111637e77b && git checkout -q FETCH_HEAD && rm -rf .git
RUN cd /workspace/lerobot && pip install --no-cache-dir --no-deps --no-build-isolation -e .
COPY setup/ /opt/skills-study/setup/
COPY variant.sh integrity.py /opt/skills-study/
# Starting state, then the variant step (no-skill deletes the guide files; with-skill changes nothing), then the
# integrity manifest of the protected upstream files (root-only, read by the verifier) and a fresh one-commit git repository.
RUN cd /workspace/lerobot && sh /opt/skills-study/setup/apply.sh && rm -rf /opt/skills-study/setup \
 && sh /opt/skills-study/variant.sh \
 && python3 /opt/skills-study/integrity.py write src/lerobot/configs src/lerobot/datasets src/lerobot/processor/pipeline.py src/lerobot/utils/import_utils.py > /opt/skills-study/protected.sha256 \
 && chmod -R go-rwx /opt/skills-study \
 && git init -q && git add -A \
 && git -c user.name=workspace -c user.email=workspace@localhost commit -qm "Workspace" \
 && mkdir -p /logs/verifier /logs/agent /logs/artifacts
ENV PYTHONUNBUFFERED=1
WORKDIR /workspace/lerobot
